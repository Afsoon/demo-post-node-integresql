# Server
PORT=3000
# Bearer token required by every API route (min 16 chars). Generate: openssl rand -hex 24
API_TOKEN=dev-token-change-me-please

# Database through the pgtest Unix socket (/tmp/pgtest/.s.PGSQL.6432)
DATABASE_URL=postgres://metered:metered@%2Ftmp%2Fpgtest:6432/metered

# Polar (https://polar.sh) — leave POLAR_ACCESS_TOKEN empty to run with a no-op billing provider
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
# One-time product charged by usage sync orders (required when POLAR_ACCESS_TOKEN is set)
POLAR_PRODUCT_ID=
