# Loaded by vitest.config.ts with process.loadEnvFile (no dotenv). Committed on purpose: no secrets.
API_TOKEN=test-api-token-0123456789
POLAR_ENVIRONMENT=sandbox
# Fake Polar credentials: the real SDK client runs, each TestApi's MSW server answers instead of Polar
POLAR_ACCESS_TOKEN=polar_oat_test
POLAR_PRODUCT_ID=prod_usage_test
# keep the TimescaleDB + integresql containers warm between runs
TESTCONTAINERS_REUSE_ENABLE=true
# pg pool size per test database (each connection to a fresh clone is a cold backend)
TEST_PG_POOL_MAX=2
# Shared pgtest control connection: directory containing .s.PGSQL.<port>, visible to test workers.
PGTEST_SOCKET_DIR=/private/tmp/pgtest
PGTEST_SOCKET_PORT=6432
