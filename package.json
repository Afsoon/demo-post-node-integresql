{
  "name": "demo-post-node-integresql",
  "type": "module",
  "scripts": {
    "dev": "nub --watch --env-file-if-exists=.env.development --env-file-if-exists=.env.local src/index.ts",
    "start": "nub --env-file-if-exists=.env.development --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "nub --env-file-if-exists=.env.development --env-file-if-exists=.env.local src/infra/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@polar-sh/sdk": "1.0.0-alpha.16",
    "@scalar/hono-api-reference": "^0.11.14",
    "@valibot/to-json-schema": "^1.7.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.3",
    "hono-openapi": "^1.3.1",
    "pg": "^8.23.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@devoxa/integresql-client": "^2.1.2",
    "@nubjs/types": "^0.7.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "msw": "^2.15.0",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
